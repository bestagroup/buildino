{
    "openapi": "3.0.0",
    "info": {
        "title": "Buildino API",
        "description": "Building Management System API",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "Buildino API V1"
        }
    ],
    "paths": {
        "/auth/otp/request": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Request OTP",
                "description": "Requests a one-time verification code for authentication.",
                "operationId": "authRequestOtp",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "identifier",
                                    "channel"
                                ],
                                "properties": {
                                    "identifier": {
                                        "type": "string",
                                        "example": "09121234567"
                                    },
                                    "channel": {
                                        "type": "string",
                                        "example": "sms"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "OTP request accepted",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "If the account is eligible, a verification code has been sent."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    }
                }
            }
        },
        "/auth/otp/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login with OTP",
                "description": "Authenticates a user using a previously issued OTP.",
                "operationId": "authLoginWithOtp",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/OtpLoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Authentication successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    }
                }
            }
        },
        "/auth/password/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Login with password",
                "description": "Authenticates a user using credentials and returns a Sanctum access token.",
                "operationId": "authLoginWithPassword",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PasswordLoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Authentication successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthenticatedResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests"
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Get authenticated user",
                "description": "Returns the currently authenticated user.",
                "operationId": "authMe",
                "responses": {
                    "200": {
                        "description": "Authenticated user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthenticatedUser"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthenticatedResponse"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ForbiddenResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/auth/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout current device",
                "description": "Revokes the current Sanctum access token.",
                "operationId": "authLogout",
                "responses": {
                    "204": {
                        "description": "Logged out successfully"
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthenticatedResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/auth/logout-all": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Logout all devices",
                "description": "Revokes all Sanctum access tokens belonging to the authenticated user.",
                "operationId": "authLogoutAll",
                "responses": {
                    "204": {
                        "description": "All access tokens revoked"
                    },
                    "401": {
                        "description": "Unauthenticated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnauthenticatedResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/buildings": {
            "get": {
                "tags": [
                    "Buildings"
                ],
                "summary": "List buildings",
                "description": "Returns only buildings visible to the authenticated user based on global, complex or building scoped assignments.",
                "operationId": "buildingsIndex",
                "parameters": [
                    {
                        "name": "complex_id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "is_active",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 20,
                            "maximum": 100,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Building list"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Buildings"
                ],
                "summary": "Create building",
                "description": "Creates a building only when the authenticated user has buildings.create permission in the requested complex scope or globally.",
                "operationId": "buildingsStore",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BuildingRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Building created"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Complex not found"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/buildings/{building}": {
            "get": {
                "tags": [
                    "Buildings"
                ],
                "summary": "Show building",
                "operationId": "buildingsShow",
                "parameters": [
                    {
                        "name": "building",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Building details"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Building not found"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Buildings"
                ],
                "summary": "Update building",
                "operationId": "buildingsUpdate",
                "parameters": [
                    {
                        "name": "building",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BuildingRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Building updated"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Building not found"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Buildings"
                ],
                "summary": "Delete building",
                "operationId": "buildingsDestroy",
                "parameters": [
                    {
                        "name": "building",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Building deleted"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Building not found"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/complexes": {
            "get": {
                "tags": [
                    "Complexes"
                ],
                "summary": "List complexes",
                "operationId": "complexesIndex",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "province",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "city",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "is_active",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "default": 20,
                            "maximum": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Complex list"
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Complexes"
                ],
                "summary": "Create complex",
                "operationId": "complexesStore",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ComplexRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Complex created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Complex"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/complexes/{complex}": {
            "get": {
                "tags": [
                    "Complexes"
                ],
                "summary": "Show complex",
                "operationId": "complexesShow",
                "parameters": [
                    {
                        "name": "complex",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Complex details"
                    },
                    "404": {
                        "description": "Complex not found"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Complexes"
                ],
                "summary": "Update complex",
                "operationId": "complexesUpdate",
                "parameters": [
                    {
                        "name": "complex",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ComplexRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Complex updated"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "404": {
                        "description": "Complex not found"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Complexes"
                ],
                "summary": "Delete complex",
                "operationId": "complexesDestroy",
                "parameters": [
                    {
                        "name": "complex",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Complex deleted"
                    },
                    "404": {
                        "description": "Complex not found"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "OtpRequest": {
                "required": [
                    "mobile"
                ],
                "properties": {
                    "mobile": {
                        "type": "string",
                        "example": "09121234567"
                    }
                },
                "type": "object"
            },
            "OtpLoginRequest": {
                "required": [
                    "mobile",
                    "code"
                ],
                "properties": {
                    "mobile": {
                        "type": "string",
                        "example": "09121234567"
                    },
                    "code": {
                        "type": "string",
                        "example": "123456"
                    },
                    "device_name": {
                        "type": "string",
                        "example": "android-app"
                    }
                },
                "type": "object"
            },
            "PasswordLoginRequest": {
                "required": [
                    "mobile",
                    "password"
                ],
                "properties": {
                    "mobile": {
                        "type": "string",
                        "example": "09121234567"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "********"
                    },
                    "device_name": {
                        "type": "string",
                        "example": "web"
                    }
                },
                "type": "object"
            },
            "AuthenticatedUser": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "first_name": {
                        "type": "string",
                        "example": "حسین"
                    },
                    "last_name": {
                        "type": "string",
                        "example": "احمدی"
                    },
                    "mobile": {
                        "type": "string",
                        "example": "09121234567"
                    },
                    "email": {
                        "type": "string",
                        "example": "user@example.com",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "LoginResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "ورود با موفقیت انجام شد."
                    },
                    "data": {
                        "properties": {
                            "token": {
                                "type": "string",
                                "example": "1|xxxxxxxxxxxxxxxx"
                            },
                            "token_type": {
                                "type": "string",
                                "example": "Bearer"
                            },
                            "user": {
                                "$ref": "#/components/schemas/AuthenticatedUser"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "BuildingRequest": {
                "required": [
                    "complex_id",
                    "code",
                    "title"
                ],
                "properties": {
                    "complex_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "code": {
                        "type": "string",
                        "example": "BLD-001"
                    },
                    "title": {
                        "type": "string",
                        "example": "ساختمان شماره یک"
                    },
                    "building_number": {
                        "type": "string",
                        "example": "A",
                        "nullable": true
                    },
                    "address": {
                        "type": "string",
                        "nullable": true
                    },
                    "postal_code": {
                        "type": "string",
                        "nullable": true
                    },
                    "latitude": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "longitude": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "timezone": {
                        "type": "string",
                        "example": "Asia/Tehran"
                    },
                    "currency": {
                        "type": "string",
                        "example": "IRR"
                    },
                    "floors_count": {
                        "type": "integer",
                        "example": 10,
                        "minimum": 0
                    },
                    "units_count": {
                        "type": "integer",
                        "example": 40,
                        "minimum": 0
                    },
                    "parking_count": {
                        "type": "integer",
                        "example": 40,
                        "minimum": 0
                    },
                    "storage_count": {
                        "type": "integer",
                        "example": 40,
                        "minimum": 0
                    },
                    "construction_year": {
                        "type": "integer",
                        "example": 1402,
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "Building": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "complex_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "code": {
                        "type": "string",
                        "example": "BLD-001"
                    },
                    "title": {
                        "type": "string",
                        "example": "ساختمان شماره یک"
                    },
                    "building_number": {
                        "type": "string",
                        "nullable": true
                    },
                    "timezone": {
                        "type": "string",
                        "example": "Asia/Tehran"
                    },
                    "currency": {
                        "type": "string",
                        "example": "IRR"
                    },
                    "construction_year": {
                        "type": "integer",
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "ValidationErrorResponse": {
                "required": [
                    "success",
                    "message",
                    "code",
                    "errors"
                ],
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "اطلاعات ارسال‌شده معتبر نیست."
                    },
                    "code": {
                        "type": "string",
                        "example": "VALIDATION_ERROR"
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "type": "object"
            },
            "UnauthenticatedResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "احراز هویت انجام نشده است."
                    },
                    "code": {
                        "type": "string",
                        "example": "UNAUTHENTICATED"
                    }
                },
                "type": "object"
            },
            "ForbiddenResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "شما مجوز انجام این عملیات را ندارید."
                    },
                    "code": {
                        "type": "string",
                        "example": "FORBIDDEN"
                    }
                },
                "type": "object"
            },
            "NotFoundResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "message": {
                        "type": "string",
                        "example": "منبع موردنظر یافت نشد."
                    },
                    "code": {
                        "type": "string",
                        "example": "RESOURCE_NOT_FOUND"
                    }
                },
                "type": "object"
            },
            "Complex": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "code": {
                        "type": "string",
                        "example": "CMP-001"
                    },
                    "title": {
                        "type": "string",
                        "example": "مجتمع مسکونی آفتاب"
                    },
                    "province": {
                        "type": "string",
                        "example": "تهران"
                    },
                    "city": {
                        "type": "string",
                        "example": "تهران"
                    },
                    "address": {
                        "type": "string",
                        "nullable": true
                    },
                    "postal_code": {
                        "type": "string",
                        "nullable": true
                    },
                    "latitude": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "longitude": {
                        "type": "number",
                        "format": "double",
                        "nullable": true
                    },
                    "sort_order": {
                        "type": "integer",
                        "example": 0
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            },
            "ComplexRequest": {
                "required": [
                    "code",
                    "title",
                    "province",
                    "city"
                ],
                "properties": {
                    "code": {
                        "type": "string",
                        "example": "CMP-001"
