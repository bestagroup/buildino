APP_NAME=Buildino
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API security and authentication
API_RATE_LIMIT=120
AUTH_RATE_LIMIT=10
OTP_REQUEST_RATE_LIMIT=5
PAYMENT_RATE_LIMIT=30
API_REQUIRE_VERIFIED_IDENTITY=true
OTP_DIGITS=6
OTP_TTL_MINUTES=2
OTP_MAX_ATTEMPTS=5
OTP_RESEND_AFTER_SECONDS=60
OTP_LOG_CHANNEL=

# Private file storage and malware scanning
FILE_DISK=private
FILE_SCAN_ENABLED=false
FILE_SCAN_DRIVER=binary
FILE_SCAN_BINARY=clamdscan
FILE_SCAN_HOST=127.0.0.1
FILE_SCAN_PORT=3310
FILE_SCAN_TIMEOUT_SECONDS=30

# Notification delivery
NOTIFICATION_QUEUE=notifications
NOTIFICATION_PROCESSING_STALE_SECONDS=90
SMS_PROVIDER=log
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=
SMS_HTTP_TOKEN_HEADER=Authorization
SMS_HTTP_TOKEN_PREFIX="Bearer "
SMS_HTTP_SENDER=Buildino
SMS_HTTP_TIMEOUT=15
SMS_HTTP_MESSAGE_ID_PATH=id
PUSH_PROVIDER=log
PUSH_HTTP_ENDPOINT=
PUSH_HTTP_TOKEN=
PUSH_HTTP_TOKEN_HEADER=Authorization
PUSH_HTTP_TOKEN_PREFIX="Bearer "
PUSH_HTTP_TIMEOUT=15
PUSH_HTTP_MESSAGE_ID_PATH=id
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
FCM_CREDENTIALS_JSON_BASE64=
FCM_TIMEOUT=15
FCM_ANDROID_PRIORITY=high
FCM_APNS_PRIORITY=10

# Payment gateway
PAYMENT_GATEWAY_DEFAULT=generic
PAYMENT_GATEWAY_CALLBACK_BASE_URL="${APP_URL}"
PAYMENT_GATEWAY_WEBHOOK_MAX_SKEW=300
PAYMENT_GATEWAY_INITIATION_CLAIM_TTL=90
PAYMENT_GATEWAY_GENERIC_ENABLED=false
PAYMENT_GATEWAY_GENERIC_REQUEST_URL=
PAYMENT_GATEWAY_GENERIC_VERIFY_URL=
PAYMENT_GATEWAY_GENERIC_MERCHANT_ID=
PAYMENT_GATEWAY_GENERIC_SECRET=
PAYMENT_GATEWAY_GENERIC_WEBHOOK_SECRET=
PAYMENT_GATEWAY_GENERIC_TIMEOUT=15
PAYMENT_GATEWAY_GENERIC_SIGN_REQUESTS=true
PAYMENT_GATEWAY_GENERIC_REDIRECT_TEMPLATE=

# Report exports
REPORT_EXPORT_DISK=local
REPORT_EXPORT_DIRECTORY=generated-reports
REPORT_EXPORT_QUEUE=reports
REPORT_EXPORT_RETENTION_DAYS=7
REPORT_EXPORT_MAX_ROWS=50000

# Mobile API compatibility
MOBILE_MIN_SUPPORTED_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0
MOBILE_MAINTENANCE_MODE=false
MOBILE_MAINTENANCE_MESSAGE="سامانه موقتاً در حال بروزرسانی است."

# Runtime health thresholds
HEALTH_REQUIRED_QUEUES=default,reports,notifications
HEALTH_SCHEDULER_STALE_SECONDS=180
HEALTH_QUEUE_WORKER_STALE_SECONDS=300
HEALTH_QUEUE_BACKLOG_WARNING=100
HEALTH_QUEUE_BACKLOG_CRITICAL=500
HEALTH_QUEUE_OLDEST_WARNING_SECONDS=300
HEALTH_QUEUE_OLDEST_CRITICAL_SECONDS=900
HEALTH_FAILED_JOBS_WARNING=1
HEALTH_STORAGE_DISK=local
HEALTH_FAILED_ACCOUNTING_WARNING=1
HEALTH_FAILED_GATEWAY_WARNING=1
HEALTH_STALE_REPORT_MINUTES=30
HEALTH_FAILED_NOTIFICATIONS_WARNING=1
HEALTH_STALE_NOTIFICATION_MINUTES=15
